{
  "name": "heijinwangchao",
  "version": "1.0.0-beta",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "predev": "npm run filenames:check",
    "dev": "vite",
    "build": "npm run filenames:check && npm run catalog:check && npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "filenames:check": "node scripts/check-source-filenames.mjs",
    "check": "npm run filenames:check && npm run lint && npm run prompts:budget && npm run test && npm run build",
    "test:e2e": "playwright test",
    "prompts:refresh": "node scripts/refresh-prompt-metadata.mjs",
    "prompts:check": "vitest run src/tests/prompts.test.ts src/tests/prompt-runtime.test.ts src/tests/prompt-inspector.test.ts",
    "catalog:refresh": "node scripts/refresh-command-catalog.mjs",
    "catalog:check": "node scripts/refresh-command-catalog.mjs --check",
    "prompts:budget": "node scripts/measure-variable-prompts.mjs"
  },
  "dependencies": {
    "jquery": "3.7.1",
    "lodash": "4.17.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/jquery": "^3.5.34",
    "@types/lodash": "^4.17.27",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
